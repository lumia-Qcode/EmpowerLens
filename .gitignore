# --- Python / envs ---
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# --- Model weights & checkpoints (never commit — see CLAUDE.md) ---
*.pt
*.bin
*.safetensors
checkpoints/
wandb/

# --- HuggingFace / misc caches ---
.cache/

# NOTE: data/splits/ is intentionally NOT ignored — the frozen train/val/test
# CSVs and split_manifest.json MUST be committed so every run reads the same
# splits. Do not add data/splits/ here.

# --- PatternReframe ---
# The 2.4 MB tarball IS committed (data/patternreframe/*.tar.gz) so the pipeline
# runs offline. The 23 MB it extracts to is DERIVED — regenerated on demand by
# src/make_splits_patternreframe.py, never committed.
data/patternreframe/extracted/
# Derived splits: val/test are byte-identical copies of data/splits_stage2, and
# train is regenerated deterministically from the tarball above. Not committed —
# unlike the frozen eval splits, there is nothing here to pin.
data/splits_stage2_pr/
data/splits_pr/

# sequential fine-tuning scratch dirs (local bootstrap exec side-effect)
ckpt_seq*/
data/splits_pr_only/

# Smoke-run scratch output (--smoke): never a real result, never committed
results_*_smoke/
